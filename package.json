{
  "name": "cursodev_aulas",
  "version": "1.0.0",
  "description": "Aqui eu irei expor tudo o que estou aprendendo com o curso.dev e aplicando.",
  "main": "index.js",
  "scripts": {
    "dev": "npm run compose:up && npm run wait-for-postgres && npm run migration:up && next dev",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "next lint .",
    "test": "npm run compose:up && npm run wait-for-postgres && concurrently --n next,jest --hide next --k --s command-jest 'next dev' 'jest --runInBand'",
    "test:watch": "jest --watchAll --runInBand",
    "compose:up": "docker compose -f infra/compose.yaml up -d",
    "compose:stop": "docker compose -f infra/compose.yaml stop",
    "compose:down": "docker compose -f infra/compose.yaml down",
    "migration:create": "node-pg-migrate -m infra/migrations create",
    "migration:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "wait-for-postgres": "node infra/scripts/wait-for-postgres.js",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "async-retry": "1.3.3",
    "dotenv": "18.0.9",
    "dotenv-expand": "1000.0.0",
    "next": "16.4.3",
    "node-pg-migrate": "6.2.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "commitizen": "4.3.2",
    "concurrently": "10.0.6",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.17.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "prettier": "3.9.10"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
